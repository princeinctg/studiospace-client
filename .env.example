# ========================================================
# StudioSpace Client — Environment Variables
# ========================================================
# Copy this file to .env.local for local development.
# NEVER commit real credentials or .env to version control.

# Backend API Base URL
# - Local development: http://localhost:5000/api
# - Production (Netlify / Vercel): https://studiospace-server-f9ek.onrender.com/api
NEXT_PUBLIC_API_URL=https://studiospace-server-f9ek.onrender.com/api

# --------------------------------------------------------
# Google OAuth 2.0 Configuration
# --------------------------------------------------------
# Feature toggle: set to "true" to re-enable Google Sign-In & Sign-Up once
# authorized redirect URIs are configured in Google Cloud Console.
# (Defaults to false to prevent redirect_uri_mismatch errors)
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Google Cloud Console OAuth 2.0 Client ID (studiospace-client-513508)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=199695232756-9b1its7cgdvpc03e1uo875fcc1ccvu8d.apps.googleusercontent.com
